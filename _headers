# === Header Netlify ===
# CSS e JS: cache lunga, hanno il ?v=N per forzare l'aggiornamento.
# Le immagini NON ce l'hanno: se ne sostituisci una tieni un nome nuovo,
# altrimenti chi e' gia' passato continua a vedere la vecchia.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

# Le pagine HTML devono aggiornarsi subito
/*.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Netlify confronta il percorso della richiesta, non il file che risolve: la home
# arriva come "/" e non come "/index.html", quindi il blocco qui sopra non la
# coprirebbe. Gli header di sicurezza vanno su tutto, la cache corta no.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
